# ─────────────────────────────────────────────────────────────────────────────
# AniStream — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in your values.
# Render / Railway: set these in the dashboard's "Environment" tab instead.
# ─────────────────────────────────────────────────────────────────────────────

# ── HTTP port ───────────────────────────────────────────────────────────────
# Render / Railway AUTO-INJECT this — don't set manually on those platforms.
PORT=8080

# ── Vite base path ──────────────────────────────────────────────────────────
BASE_PATH=/

# ── Your site domain (optional, for CORS lockdown) ──────────────────────────
# Leave empty in dev (CORS opens up to localhost).
WEB_DOMAIN=

# ── Embed / Stream API origin ───────────────────────────────────────────────
# The origin of YOUR hosted embed/stream API. This is what the Core, AniNico,
# and VidStream providers call under the hood to resolve stream URLs.
#
# The URL structure is: {EMBED_API_URL}/api/stream/anix.at/{anilistId}/{epNum}/{type}
# After /api/stream/anix.at/, our code handles the rest (anime ID, episode, audio type).
#
# Default (if unset): the original Koyeb URL
# Examples:
#   EMBED_API_URL=https://myapi.koyeb.app
#   EMBED_API_URL=https://workspaceapi-client-react-production-d29d.up.railway.app
#   EMBED_API_URL=https://stream-foo.anix.at
#   EMBED_API_URL=                          ← empty = use default Koyeb
EMBED_API_URL=https://workspaceapi-client-react-production-d29d.up.railway.app

# ── Proxy secret (optional) ─────────────────────────────────────────────────
# Signs proxy URLs. If unset, uses a built-in default.
# Set to a custom value only if you want to invalidate signed URLs on redeploy.
PROXY_SECRET=

# ── Schedule: Miruro API toggle (optional) ───────────────────────────────────
# If true, upcoming schedule data is fetched from the Miruro render.com API
# FIRST, then merged with AniList for past episodes. Gives the most complete
# weekly schedule (past from AniList + upcoming from Miruro).
# If false (default), all schedule data comes from AniList only.
# If Miruro fails, silently falls back to AniList — site is never affected.
USE_MIRURO_SCHEDULE=true

# ── Node environment ────────────────────────────────────────────────────────
NODE_ENV=production

# ── Static frontend directory (set automatically by Dockerfile) ─────────────
STATIC_DIR=/app/public
