# ─────────────────────────────────────────────────────────────────────────────
# AniStream — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in your values.
# Render / Railway: set these in the dashboard's "Environment" tab instead.
# ─────────────────────────────────────────────────────────────────────────────

# ── HTTP port ───────────────────────────────────────────────────────────────
# Render / Railway AUTO-INJECT this — don't set manually on those platforms.
# Local dev: 8080 (api-server) + 3000 (vite dev server, separate process).
PORT=8080

# ── Vite base path ──────────────────────────────────────────────────────────
# Almost always "/". Only change if deploying to a subpath like "/app/".
BASE_PATH=/

# ── Your site domain (REQUIRED for production) ──────────────────────────────
# The full URL where users access your site.
#
# Pattern: https://<subdomain>.<your-domain>.<tld>
# Example: https://stream-api.streams-anex.net
#          https://stream-foo.streams-are-annex.net
#
# Used for:
#   1. CORS lockdown — only this origin can call /api/*
#   2. Future use: canonical URLs, OG tags, etc.
#
# Leave empty in dev (CORS opens up to localhost).
WEB_DOMAIN=https://stream-api.streams-anex.net

# ── Embed / Stream API origin (the "core" provider's upstream) ──────────────
# The origin of YOUR hosted embed/stream API. This is what the Core, AniNico,
# and VidStream providers call under the hood to resolve stream URLs.
#
# If you've hosted the embed API elsewhere (your own Koyeb / Railway / Render
# instance, or your own domain like https://stream-foo.anix.at), put THAT
# origin here. Trailing slash is stripped automatically.
#
# Leave empty to use the original default Koyeb URL.
# Examples:
#   EMBED_API_URL=https://myapi.koyeb.app
#   EMBED_API_URL=https://stream-foo.anix.at
#   EMBED_API_URL=                          ← empty = use default
#
EMBED_API_URL=

# ── Frontend → API origin (BUILD-TIME, only for standalone frontend deploys) ─
# By default the frontend calls /api/* on the SAME origin it's served from
# (i.e. the backend in this same Docker container). Set VITE_API_BASE_URL at
# BUILD time ONLY if you want the frontend to call a DIFFERENT API origin
# directly (skipping this container's backend).
#
# This is a BUILD-time variable (Vite inlines it). Re-build after changing.
# Leave empty for same-origin (the normal full-stack Docker deploy).
#
# Examples:
#   VITE_API_BASE_URL=                      ← empty = same-origin (default)
#   VITE_API_BASE_URL=https://myapi.koyeb.app
#
VITE_API_BASE_URL=

# ── Node environment ────────────────────────────────────────────────────────
# Always "production" in Docker. Set to "development" only for local dev.
NODE_ENV=production

# ── Static frontend directory (set automatically by Dockerfile) ─────────────
# Don't change unless you know what you're doing.
STATIC_DIR=/app/public
